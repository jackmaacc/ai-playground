# Copy this file to .env and paste your key in. .env is git-ignored.
MOONSHOT_API_KEY=sk-your-key-here

# Optional. The international endpoint is the default; use the .cn one if
# your key was issued by platform.moonshot.cn instead of platform.moonshot.ai.
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Optional. Leave unset to auto-pick the newest Kimi K2 model your key can see.
# MOONSHOT_MODEL=kimi-k2-thinking
